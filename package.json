{
  "name": "@sensearena/ui",
  "version": "0.3.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node scripts/prepare-package.mjs",
    "build:test": "pnpm typecheck && vite build --mode analyze && node scripts/prepare-package.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.stories.json",
    "test": "node scripts/test-package.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "pnpm build",
    "test:storybook": "node scripts/test-storybook.mjs"
  },
  "devDependencies": {
    "@react-spring/web": "10.1.2",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-links": "10.6.3",
    "@storybook/react": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/rollup-plugin": "1.5.4",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "4.64.12",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "10.6.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "@react-spring/web": "9.x || 10.x",
    "@vanilla-extract/css": "1.x",
    "@vanilla-extract/recipes": "0.x",
    "react": "18.x || 19.x",
    "react-dom": "18.x || 19.x"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/@sa-ui.umd.js",
  "module": "./dist/@sa-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/@sa-ui.es.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/@sa-ui.umd.js"
      }
    },
    "./theme.css": "./dist/style.css"
  }
}
